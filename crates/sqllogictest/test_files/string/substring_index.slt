# Expected results verified against Apache Spark 4.2.0. UTF8_BINARY only.

query T
SELECT substring_index(s, d, c) FROM (VALUES
  ('www.apache.org', '.', (3)::INT),
  ('www.apache.org', '.', (2)::INT),
  ('www.apache.org', '.', (1)::INT),
  ('www.apache.org', '.', (0)::INT),
  ('www.apache.org', '.', (-1)::INT),
  ('www.apache.org', '.', (-2)::INT),
  ('www.apache.org', '.', (-3)::INT),
  ('www.apache.org', '.', (10)::INT),
  ('www.apache.org', '.', (-10)::INT),
  ('', '.', (1)::INT),
  ('', '.', (-2)::INT),
  ('www.apache.org', '', (1)::INT),
  ('www.apache.org', '', (-1)::INT),
  ('www.apache.org', '#', (2)::INT),
  ('www||apache||org', '||', (2)::INT),
  ('www||apache||org', '||', (-2)::INT),
  ('大千世界大千世界', '千', (2)::INT),
  ('||||||', '|||', (3)::INT),
  ('||||||', '|||', (-4)::INT),
  ('aaaaa', 'aa', (2)::INT),
  ('aaaaa', 'aa', (-2)::INT),
  ('abababa', 'aba', (2)::INT),
  ('abababa', 'aba', (-2)::INT),
  ('😀😀😀', '😀😀', (2)::INT),
  ('😀😀😀', '😀😀', (-2)::INT),
  ('.a', '.', (1)::INT),
  ('a.', '.', (-1)::INT),
  ('abc', 'abc', (1)::INT),
  ('abc', 'abc', (-1)::INT),
  ('ab', 'abcd', (1)::INT),
  ('ab', 'abcd', (-1)::INT),
  ('ABCabc', 'a', (1)::INT),
  ('中文.测试.数据', '.', (-1)::INT),
  ('中文.测试.数据', '.', (2)::INT),
  ('a.b', '.', (2147483647)::INT),
  ('a.b', '.', (-2147483647)::INT),
  ('abc', '', (-2147483648)::INT),
  ('abc', '', (0)::INT),
  (NULL::STRING, '.', (-2147483648)::INT),
  ('abc', NULL::STRING, (-2147483648)::INT),
  ('abc', '.', NULL::INT),
  (NULL::STRING, '', (0)::INT)) AS t(s, d, c);
----
www.apache.org
www.apache
www
(empty)
org
apache.org
www.apache.org
www.apache.org
www.apache.org
(empty)
(empty)
(empty)
(empty)
www.apache.org
www||apache
apache||org
大千世界大
||
|||
a
a
ab
ba
😀
😀
(empty)
(empty)
(empty)
(empty)
ab
ab
ABC
数据
中文.测试
a.b
a.b
(empty)
(empty)
NULL
NULL
NULL
NULL

