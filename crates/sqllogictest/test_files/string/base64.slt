Spark SQ
NULL

# 'YQ= =' has a space between the two padding bytes. The MIME decoder does
# not skip whitespace while reading the second '=', so this is rejected.
# A space before the padding ('YQ ==') is skipped in the main loop.
query error Failed to decode value using base64: Input byte array has wrong 4-byte ending unit
SELECT unbase64('YQ= ='::string);

query error Failed to decode value using base64: Input byte array has wrong 4-byte ending unit
SELECT unbase64('YQ= ='::bytea);

query T
SELECT hex(unbase64('YQ =='::string));
----
61

# URL-safe characters are outside the MIME alphabet and are skipped, so
# 'YQ-_' decodes as 'YQ' ('a'). Standard '+/' is decoded as usual.
query T
SELECT hex(unbase64('YQ-_'::string));
----
61

query T
SELECT hex(unbase64('YQ-_'::bytea));
----
61

query T
SELECT hex(unbase64(arrow_cast('YQ-_', 'Utf8View')));
----
61

query T
SELECT hex(unbase64(arrow_cast('YQ-_', 'LargeUtf8')));
----
61

query T
SELECT hex(unbase64(arrow_cast('YQ-_', 'BinaryView')));
----
61

query T
SELECT hex(unbase64('YQ+/'::string));
----
610FBF

# CR/LF inside the input is skipped the same way as a space
query T
SELECT hex(unbase64(X'59574A6A0D0A5A47566D'));
----
616263646566

# trailing non-alphabet after padding is ignored, including extra '='
query T
SELECT hex(unbase64('YQ==  '::string));
----
61

query T
SELECT hex(unbase64('YQ==='::string));
----
61

query T
SELECT hex(unbase64('YQ==!!'::string));
----
61

# trailing base64 after padding is still rejected, even with a space
query error Failed to decode value using base64: Input byte array has incorrect ending byte
SELECT unbase64('YQ== YQ'::string);

# non-ASCII bytes are skipped. 'YéQ' is Y, U+00E9, Q; both the UTF-8
# encoding and a raw Latin-1 0xE9 sit outside the alphabet, leaving 'YQ'
query T
SELECT hex(unbase64('YéQ'::string));
----
61

query T
SELECT hex(unbase64(X'59C3A951'));
----
61

query T
SELECT hex(unbase64(X'59E951'));
----
61
