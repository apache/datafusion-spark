# Expected results verified against Spark 4.2.0 with default ICU case mappings.

query T
SELECT lcase('SparkSql');
----
sparksql

query T
SELECT lcase('Σ');
----
σ

query T
SELECT lcase('ΘΑΛΑΣΣΙΝΟΣ');
----
θαλασσινος

query T
SELECT lcase('İ');
----
i̇

query T
SELECT lcase('𐐅');
----
𐐭

query T
SELECT lcase('');
----
(empty)

query T
SELECT lcase(NULL::STRING);
----
NULL

query T
SELECT lcase(arrow_cast(s, 'Utf8')) FROM (VALUES
  ('SparkSql'),
  ('ÄBĆΔE'),
  ('ΣΑΛΑΤΑ'),
  ('ΘΑΛΑΣΣΙΝΟΣ'),
  ('Σ'),
  ('ΣΑΣ X'),
  ('ΣΑΣ!'),
  ('ΑΣ́'),
  ('ΑΣ́Α'),
  ('ΑΣ’'),
  ('ΑΣ’Α'),
  ('I'),
  ('İ'),
  ('FIDELİO'),
  ('Iİ'),
  ('ß ﬁ ﬃ ﬀ ﬆ ῗ'),
  ('𐐅'),
  ('𝔸'),
  ('a🙃B🙃c'),
  ('ςαλατα'),
  ('θαλασσινοσ'),
  ('ASCII ONLY 123'),
  ('123!?'),
  (''),
  (NULL::STRING),
  ('AAAAAAAAAAİ'),
  ('İİİİİİ'),
  ('HELLO WORLD LONG ASCII'),
  ('ΣΣ'),
  ('́Σ')) AS t(s);
----
sparksql
äbćδe
σαλατα
θαλασσινος
σ
