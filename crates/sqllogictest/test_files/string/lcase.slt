query T
SELECT lcase(123::INT);
----
123

query T
SELECT lcase((-123)::BIGINT);
----
-123

query T
SELECT lcase(1.25::DOUBLE);
----
1.25

query T
SELECT lcase('1.25'::DECIMAL(3,2));
----
1.25

query T
SELECT lcase(true);
----
true

query T
SELECT lcase(DATE '2020-02-29');
----
2020-02-29

query error DATATYPE_MISMATCH.UNEXPECTED_INPUT_TYPE
