query T
SELECT concat(space(1::INT), 'Spark');
----
 Spark

query T
SELECT concat(space(5::INT), 'Spark');
----
     Spark

query T
SELECT space(0::INT);
----
(empty)

query T
SELECT space(-1::INT);
----
(empty)

query T
SELECT space(NULL);
----
NULL

# An integer literal is BIGINT here and INT in Spark, where this works (https://github.com/apache/datafusion-spark/issues/97)
statement error Failed to coerce arguments to satisfy a call to 'space' function
SELECT space(2);
