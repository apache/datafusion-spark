# Tests for Spark-compatible xxhash64
# Reference: https://spark.apache.org/docs/latest/api/sql/index.html#xxhash64

# Basic integer tests (Int32 - hashed as 4 bytes)
query I
SELECT xxhash64(1);
----
-7001672635703045582

query I
SELECT xxhash64(0);
----
-5252525462095825812

query I
SELECT xxhash64(-1);
----
3858142552250413010

# Boundary values
query I
SELECT xxhash64(arrow_cast(2147483647, 'Int32'));
----
1508894993788531228

query I
SELECT xxhash64(arrow_cast(-2147483648, 'Int32'));
----
2073849959933241805

query I
SELECT xxhash64(arrow_cast(9223372036854775807, 'Int64'));
----
-3246596055638297850

query I
SELECT xxhash64(arrow_cast(-9223372036854775808, 'Int64'));
----
-8619748838626508300

# String tests
query I
SELECT xxhash64('hello');
----
-4367754540140381902

query I
SELECT xxhash64('');
----
-7444071767201028348

query I
SELECT xxhash64('abc');
----
1423657621850124518

# Emoji and CJK strings
query I
SELECT xxhash64('😁');
----
-6337236088984028203

query I
SELECT xxhash64('天地');
----
-235771157374669727

# NULL handling - nulls don't change the hash (keeps seed value 42)
query I
SELECT xxhash64(NULL);
----
42

# Multiple column hashing
query I
SELECT xxhash64(1, 2);
----
-8198029865082835910

query I
SELECT xxhash64('a', 'b', 'c');
----
-8775012835737190202

query I
SELECT xxhash64(1, 'hello');
----
-7340167327466467369

# Int64 tests
query I
SELECT xxhash64(arrow_cast(1, 'Int64'));
----
-7001672635703045582

query I
SELECT xxhash64(arrow_cast(0, 'Int64'));
----
-5252525462095825812

# Float tests - note: -0.0 and 0.0 hash to the same value in Spark
query I
SELECT xxhash64(1.0);
----
-2162451265447482029

query I
SELECT xxhash64(0.0);
----
-5252525462095825812

query I
SELECT xxhash64(-0.0);
----
-5252525462095825812

# Float edge cases
query I
SELECT xxhash64(-1.0);
----
-8296228499959607521

query I
SELECT xxhash64(arrow_cast(1.0E20, 'Float64'));
----
-1089066926670605926

# Boolean tests
query I
SELECT xxhash64(true);
----
-6698625589789238999

query I
SELECT xxhash64(false);
----
3614696996920510707

# Binary tests
query I
SELECT xxhash64(arrow_cast('hello', 'Binary'));
----
-4367754540140381902

# Date tests
query I
SELECT xxhash64(arrow_cast('2023-01-15', 'Date32'));
----
290591839883576215

# Struct hashing
query I
SELECT xxhash64(named_struct('a', 1, 'b', 2));
----
-8198029865082835910

# Array/List hashing - Spark chains hashes across list elements:
# hash(elem_n, hash(elem_n-1, ... hash(elem_0, seed) ...))
query I
SELECT xxhash64(arrow_cast(make_array(1, 2, 3), 'List(Int32)'));
----
8592097078962733837

# Test with table data
statement ok
CREATE TABLE xxhash_test AS SELECT * FROM (VALUES
    (1, 'a'),
    (2, 'b'),
    (3, 'c')
) AS t(id, name);

query II
SELECT id, xxhash64(id, name) FROM xxhash_test ORDER BY id;
----
1 -8527884376001292090
2 -7687314219880041104
3 -7773406846575579340

statement ok
DROP TABLE xxhash_test;

# A NULL struct hashes like any other NULL, whatever its fields still hold
query BII
SELECT s IS NULL,
       xxhash64(s),
       xxhash64(arrow_cast(NULL, 'Struct("a": Int64, "b": Utf8)'))
FROM (SELECT nullif(s, s) AS s FROM (SELECT named_struct('a', 1, 'b', 'x') AS s));
----
true 42 42

# A NULL struct in a later argument leaves the incoming hash unchanged
query II
SELECT xxhash64(7, nullif(s, s)), xxhash64(7)
FROM (SELECT named_struct('a', 1, 'b', 'x') AS s);
----
-2864211556195259663 -2864211556195259663

# Spark's documented example; DataFusion types 123 and 2 as BIGINT, Spark as INT
query I
SELECT xxhash64('Spark', [CAST(123 AS INT)], CAST(2 AS INT));
----
5602566077635097486

# Decimals with precision <= 18 hash as the unscaled long
query I
SELECT xxhash64(CAST(123.45 AS DECIMAL(10, 2)));
----
8791244235932249694

query I
SELECT xxhash64(CAST(-123.45 AS DECIMAL(10, 2)));
----
-4814648695243699264

# Decimals with precision > 18 hash the minimal big-endian two's complement
# bytes of the unscaled value (Java's BigInteger.toByteArray)

query I
SELECT xxhash64(CAST(1 AS DECIMAL(20, 0)));
----
6668291691252061002

query I
SELECT xxhash64(CAST(0 AS DECIMAL(20, 0)));
----
-8959994473701255385

query I
SELECT xxhash64(CAST(-1 AS DECIMAL(20, 0)));
----
-4006032525457443936

# 127 and -128 fit in one byte; 128 and -129 need a leading sign byte
query I
SELECT xxhash64(CAST(127 AS DECIMAL(20, 0)));
----
-5998106174972408993

query I
SELECT xxhash64(CAST(128 AS DECIMAL(20, 0)));
----
6715097930120473301

query I
SELECT xxhash64(CAST(-128 AS DECIMAL(20, 0)));
----
-7898411661632158123

query I
SELECT xxhash64(CAST(-129 AS DECIMAL(20, 0)));
----
-6459515886037897956

query I
SELECT xxhash64(CAST(1.5 AS DECIMAL(20, 1)));
----
7491490015795856943

query I
SELECT xxhash64(CAST('12345678901234567890.1234567890' AS DECIMAL(38, 10)));
----
7467050800690399880

query I
SELECT xxhash64(CAST('-12345678901234567890.1234567890' AS DECIMAL(38, 10)));
----
-5128632804645768173

query I
SELECT xxhash64(CAST('99999999999999999999999999999999999999' AS DECIMAL(38, 0)));
----
-47190729175993179

query I
SELECT xxhash64(CAST('-99999999999999999999999999999999999999' AS DECIMAL(38, 0)));
----
-2254039905620870768

query I
SELECT xxhash64(CAST(NULL AS DECIMAL(20, 0)));
----
42

# Wide decimals inside lists and structs
query I
SELECT xxhash64([CAST(1 AS DECIMAL(20, 0)), CAST(-129 AS DECIMAL(20, 0))]);
----
7288194727865790865

query I
SELECT xxhash64(named_struct('a', CAST(1 AS DECIMAL(20, 0))));
----
6668291691252061002
