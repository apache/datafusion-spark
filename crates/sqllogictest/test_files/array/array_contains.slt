# Tests for Spark-compatible array_contains function.
# Spark semantics: if element is found -> true; if not found and array has nulls -> null; if not found and no nulls -> false.

###
### Scalar tests
###

# Element found in array
query B
SELECT array_contains(array(1, 2, 3), 2);
----
true

# Element not found, no nulls in array
query B
SELECT array_contains(array(1, 2, 3), 4);
----
false

# Element not found, array has null elements -> null
query B
SELECT array_contains(array(1, NULL, 3), 2);
----
NULL

# Element found, array has null elements -> true (nulls don't matter)
query B
SELECT array_contains(array(1, NULL, 3), 1);
----
true

# Element found at the end, array has null elements -> true
query B
SELECT array_contains(array(1, NULL, 3), 3);
----
true

# Null array -> null
query B
SELECT array_contains(NULL, 1);
----
NULL

# Null element -> null
query B
SELECT array_contains(array(1, 2, 3), NULL);
----
NULL

# Empty array, element not found -> false
query B
SELECT array_contains(array(), 1);
----
false

# Array with only nulls, element not found -> null
query B
SELECT array_contains(array(NULL, NULL), 1);
----
NULL

# String array, element found
query B
SELECT array_contains(array('a', 'b', 'c'), 'b');
----
true

# String array, element not found, no nulls
query B
SELECT array_contains(array('a', 'b', 'c'), 'd');
----
false

# String array, element not found, has null
query B
SELECT array_contains(array('a', NULL, 'c'), 'd');
----
NULL

###
### Columnar tests with a table
###

statement ok
CREATE TABLE test_arrays AS VALUES
  (1, make_array(1, 2, 3),       10),
  (2, make_array(4, NULL, 6),    5),
  (3, make_array(7, 8, 9),       10),
  (4, NULL,                      1),
  (5, make_array(10, NULL, NULL), 10);

# Column needle against column array
query IBB
SELECT column1,
       array_contains(column2, column3),
       array_contains(column2, 10)
FROM test_arrays
ORDER BY column1;
----
1 false false
2 NULL NULL
3 false false
4 NULL NULL
5 true true

statement ok
DROP TABLE test_arrays;

###
### Nested array tests
###

# Nested array element found
query B
SELECT array_contains(array(array(1, 2), array(3, 4)), array(3, 4));
----
true

# Nested array element not found, no nulls
query B
SELECT array_contains(array(array(1, 2), array(3, 4)), array(5, 6));
----
false

###
### Floating point equality
###
# Spark compares floating point values with -0.0 == 0.0 and NaN == NaN, at any depth.

# Negative zero equals positive zero
query B
SELECT array_contains(array(-0.0::double), 0.0::double);
----
true

query B
SELECT array_contains(array(0.0::double), -0.0::double);
----
true

query B
SELECT array_contains(array(-0.0::float), 0.0::float);
----
true

# NaN equals NaN, whatever its sign bit
query B
SELECT array_contains(array('NaN'::double), 'NaN'::double);
----
true

query B
SELECT array_contains(array('NaN'::double), -('NaN'::double));
----
true

query B
SELECT array_contains(array('NaN'::float), -('NaN'::float));
----
true

# Different values still differ
query B
SELECT array_contains(array(1.5::double, 'NaN'::double), 0.0::double);
----
false

# Null semantics are unchanged
query B
SELECT array_contains(array(1.5::double, NULL), -0.0::double);
----
NULL

query B
SELECT array_contains(array(-0.0::double, NULL), 0.0::double);
----
true

# Other list types
query B
SELECT array_contains(arrow_cast(array(-0.0::double), 'LargeList(Float64)'), 0.0::double);
----
true

query B
SELECT array_contains(arrow_cast(array(-0.0::double), 'FixedSizeList(1, Float64)'), 0.0::double);
----
true

# Nested elements
query B
SELECT array_contains(array(array(-0.0::double)), array(0.0::double));
----
true

query B
SELECT array_contains(array(array('NaN'::double)), array(-('NaN'::double)));
----
true

query B
SELECT array_contains(array(arrow_cast(array('NaN'::double), 'FixedSizeList(1, Float64)')), arrow_cast(array(-('NaN'::double)), 'FixedSizeList(1, Float64)'));
----
true

query B
SELECT array_contains(array(named_struct('a', 'NaN'::double, 'b', 1)), named_struct('a', -('NaN'::double), 'b', 1));
----
true

query B
SELECT array_contains(array(named_struct('a', -0.0::double, 'b', 1)), named_struct('a', 0.0::double, 'b', 1));
----
true

query B
SELECT array_contains(array(named_struct('a', 'NaN'::double, 'b', 1)), named_struct('a', -('NaN'::double), 'b', 2));
----
false

# Columns
statement ok
CREATE TABLE test_float_arrays AS VALUES
  (1, make_array(-0.0::double, 1.5::double), 0.0::double),
  (2, make_array('NaN'::double), -('NaN'::double)),
  (3, make_array(1.5::double), 0.0::double),
  (4, make_array(0.0::double, NULL), -0.0::double);

query IB
SELECT column1, array_contains(column2, column3)
FROM test_float_arrays
ORDER BY column1;
----
1 true
2 true
3 false
4 true

statement ok
DROP TABLE test_float_arrays;
