# Tests for Spark-compatible array_contains function.
# Spark semantics: if element is found -> true; if not found and array has nulls -> null; if not found and no nulls -> false.

###
### Scalar tests
###

# Element found in array
query B
SELECT array_contains(array(1, 2, 3), 2);
----
true

# Element not found, no nulls in array
query B
SELECT array_contains(array(1, 2, 3), 4);
----
false

# Element not found, array has null elements -> null
query B
SELECT array_contains(array(1, NULL, 3), 2);
----
NULL

# Element found, array has null elements -> true (nulls don't matter)
query B
SELECT array_contains(array(1, NULL, 3), 1);
----
true

# Element found at the end, array has null elements -> true
query B
SELECT array_contains(array(1, NULL, 3), 3);
----
true

# Untyped NULL array is rejected at planning time, as in Spark.
query error \[DATATYPE_MISMATCH\.NULL_TYPE\] Null typed values cannot be used as arguments of `array_contains`
SELECT array_contains(NULL, 1);

# Untyped NULL element is rejected at planning time, as in Spark.
query error \[DATATYPE_MISMATCH\.NULL_TYPE\] Null typed values cannot be used as arguments of `array_contains`
SELECT array_contains(array(1, 2, 3), NULL);

# Both untyped NULL arguments are rejected at planning time.
query error \[DATATYPE_MISMATCH\.NULL_TYPE\] Null typed values cannot be used as arguments of `array_contains`
SELECT array_contains(NULL, NULL);

# Typed NULL array -> NULL
query B
SELECT array_contains(CAST(NULL AS ARRAY<INT>), 1);
----
NULL

# Typed NULL element -> NULL
query B
SELECT array_contains(array(1, 2, 3), CAST(NULL AS INT));
----
NULL

# Typed NULL array and element -> NULL
query B
SELECT array_contains(CAST(NULL AS ARRAY<INT>), CAST(NULL AS INT));
----
NULL

# Empty array, element not found -> false
query B
SELECT array_contains(array(), 1);
----
false

# Array with only nulls, element not found -> null
query B
SELECT array_contains(array(NULL, NULL), 1);
----
NULL

# String array, element found
query B
SELECT array_contains(array('a', 'b', 'c'), 'b');
----
true

# String array, element not found, no nulls
query B
SELECT array_contains(array('a', 'b', 'c'), 'd');
----
false

# String array, element not found, has null
query B
SELECT array_contains(array('a', NULL, 'c'), 'd');
----
NULL

###
### Columnar tests with a table
###

statement ok
CREATE TABLE test_arrays AS VALUES
  (1, make_array(1, 2, 3),       10),
  (2, make_array(4, NULL, 6),    5),
  (3, make_array(7, 8, 9),       10),
  (4, NULL,                      1),
  (5, make_array(10, NULL, NULL), 10);

# Column needle against column array
query IBB
SELECT column1,
       array_contains(column2, column3),
       array_contains(column2, 10)
FROM test_arrays
ORDER BY column1;
----
1 false false
2 NULL NULL
3 false false
4 NULL NULL
5 true true

statement ok
DROP TABLE test_arrays;

###
### Nested array tests
###

# Nested array element found
query B
SELECT array_contains(array(array(1, 2), array(3, 4)), array(3, 4));
----
true

# Nested array element not found, no nulls
query B
SELECT array_contains(array(array(1, 2), array(3, 4)), array(5, 6));
----
false

###
### Floating point equality
###
# Spark compares floating point values with -0.0 == 0.0 and NaN == NaN, at any depth.

# Negative zero equals positive zero
query B
SELECT array_contains(array(-0.0::double), 0.0::double);
----
true

query B
SELECT array_contains(array(0.0::double), -0.0::double);
----
true

query B
SELECT array_contains(array(-0.0::float), 0.0::float);
----
true

# NaN equals NaN, whatever its sign bit
query B
SELECT array_contains(array('NaN'::double), 'NaN'::double);
----
true

query B
SELECT array_contains(array('NaN'::double), -('NaN'::double));
----
true

query B
SELECT array_contains(array('NaN'::float), -('NaN'::float));
----
true

# Different values still differ
query B
SELECT array_contains(array(1.5::double, 'NaN'::double), 0.0::double);
----
false

# Null semantics are unchanged
query B
SELECT array_contains(array(1.5::double, NULL), -0.0::double);
----
NULL

query B
SELECT array_contains(array(-0.0::double, NULL), 0.0::double);
----
true

# Other list types
query B
SELECT array_contains(arrow_cast(array(-0.0::double), 'LargeList(Float64)'), 0.0::double);
----
true

query B
SELECT array_contains(arrow_cast(array(-0.0::double), 'FixedSizeList(1, Float64)'), 0.0::double);
----
true

# Nested elements
query B
SELECT array_contains(array(array(-0.0::double)), array(0.0::double));
----
true

query B
SELECT array_contains(array(array('NaN'::double)), array(-('NaN'::double)));
----
true

query B
SELECT array_contains(array(arrow_cast(array('NaN'::double), 'FixedSizeList(1, Float64)')), arrow_cast(array(-('NaN'::double)), 'FixedSizeList(1, Float64)'));
----
true

query B
SELECT array_contains(array(named_struct('a', 'NaN'::double, 'b', 1)), named_struct('a', -('NaN'::double), 'b', 1));
----
true

query B
SELECT array_contains(array(named_struct('a', -0.0::double, 'b', 1)), named_struct('a', 0.0::double, 'b', 1));
----
true

query B
SELECT array_contains(array(named_struct('a', 'NaN'::double, 'b', 1)), named_struct('a', -('NaN'::double), 'b', 2));
----
false

# Columns
statement ok
CREATE TABLE test_float_arrays AS VALUES
  (1, make_array(-0.0::double, 1.5::double), 0.0::double),
  (2, make_array('NaN'::double), -('NaN'::double)),
  (3, make_array(1.5::double), 0.0::double),
  (4, make_array(0.0::double, NULL), -0.0::double);

query IB
SELECT column1, array_contains(column2, column3)
FROM test_float_arrays
ORDER BY column1;
----
1 true
2 true
3 false
4 true

statement ok
DROP TABLE test_float_arrays;

###
### Type coercion
###

# The array element and the search element are both cast to their wider type
# (Spark's findWiderTypeWithoutStringPromotionForTwo): here INT and BIGINT become BIGINT.
query B
SELECT array_contains(array(CAST(1 AS INT), CAST(2 AS INT), CAST(3 AS INT)), 2L);
----
true

query B
SELECT array_contains(array(1, 2, 3), CAST(2.0 AS DOUBLE));
----
true

# INT and DOUBLE become DOUBLE, so 1.23 does not match 1
query B
SELECT array_contains(array(CAST(1 AS INT)), CAST(1.23 AS DOUBLE));
----
false

query B
SELECT array_contains(array(CAST(1 AS INT)), CAST(1.0 AS DOUBLE));
----
true

query B
SELECT array_contains(array(CAST(1 AS DOUBLE)), CAST(1 AS INT));
----
true

query B
SELECT array_contains(array(CAST(1 AS FLOAT)), 1L);
----
true

query B
SELECT array_contains(array(array(CAST(1 AS INT))), array(CAST(1.0 AS DOUBLE)));
----
true

# Decimal widening:
# Integer and decimal widen to a decimal wide enough for both
query B
SELECT array_contains(array(1, 2), CAST(1.0 AS DECIMAL(2,1)));
----
true

query B
SELECT array_contains(array(CAST(1 AS INT)), CAST(1.0 AS DECIMAL(2,1)));
----
true

query B
SELECT array_contains(array(CAST(1 AS INT)), CAST(1 AS DECIMAL(38,2)));
----
true

query B
SELECT array_contains(array(CAST(1 AS DECIMAL(12,2))), CAST(1 AS INT));
----
true

# Nested array with decimal widening
query B
SELECT array_contains(array(array(1)), array(CAST(1.0 AS DECIMAL(2,1))));
----
true

# Two decimals widen to the wider decimal type
query B
SELECT array_contains(array(CAST(1.0 AS DECIMAL(3,1))), CAST(1.00 AS DECIMAL(4,2)));
----
true

query B
SELECT array_contains(array(CAST(1.0 AS DECIMAL(3,1))), CAST(2.00 AS DECIMAL(4,2)));
----
false

# Decimals and floating point numbers widen to DOUBLE
query B
SELECT array_contains(array(CAST(1 AS DECIMAL(5,1))), CAST(1.0 AS DOUBLE));
----
true

query B
SELECT array_contains(array(CAST(1.0 AS DOUBLE)), CAST(1 AS DECIMAL(5,1)));
----
true

# Strings and numbers are not cast to each other, in either direction
query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\]
SELECT array_contains(array(1, 2), '1');

query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\] Input to `array_contains` should have been "ARRAY" followed by a value with same element type, but it's \["ARRAY<STRING>", "INT"\]\. SQLSTATE: 42K09
SELECT array_contains(array('1'), CAST(1 AS INT));

query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\]
SELECT array_contains(array(1), CAST(NULL AS STRING));

query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\]
SELECT array_contains(array(array(1)), array('1'));

query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\]
SELECT array_contains(array(true), 1);

query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\]
SELECT array_contains(array(DATE '2020-01-01'), '2020-01-01');

# First parameter must be an ARRAY
query error \[DATATYPE_MISMATCH\.UNEXPECTED_INPUT_TYPE\] The first parameter of `array_contains` requires the "ARRAY" type
SELECT array_contains(1, 1);

# A dictionary-encoded element or array has the type of its values
query BB
SELECT array_contains(array('a', 'b'), arrow_cast('b', 'Dictionary(Int32, Utf8)')), array_contains(array(arrow_cast('a', 'Dictionary(Int32, Utf8)'), arrow_cast('b', 'Dictionary(Int32, Utf8)')), 'b');
----
true true

# DATE and TIMESTAMP become TIMESTAMP
query B
SELECT array_contains(array(DATE '2020-01-01'), TIMESTAMP '2020-01-01 00:00:00');
----
true

# Struct field types are not widened, as in Spark with ANSI mode off. With ANSI mode on, Spark
# widens them and returns true here.
query error \[DATATYPE_MISMATCH\.ARRAY_FUNCTION_DIFF_TYPES\]
SELECT array_contains(array(named_struct('a', CAST(1 AS INT))), named_struct('a', 1L));

# Fields may differ in nullability
query B
SELECT array_contains(array(named_struct('a', 1, 'b', CAST(NULL AS BIGINT))), named_struct('a', 1, 'b', 2L));
----
false

query B
SELECT array_contains(array(named_struct('a', 1, 'b', 2L)), named_struct('a', 1, 'b', 2L));
----
true

# Maps cannot be ordered, so map elements are rejected at any depth
query error \[DATATYPE_MISMATCH\.INVALID_ORDERING_TYPE\] The `array_contains` does not support ordering on type
SELECT array_contains(array(map(1, 2)), map(1, 2));

query error \[DATATYPE_MISMATCH\.INVALID_ORDERING_TYPE\]
SELECT array_contains(array(named_struct('m', map(1, 2))), named_struct('m', map(1, 2)));

query error \[DATATYPE_MISMATCH\.INVALID_ORDERING_TYPE\]
SELECT array_contains(array(array(map(1, 2))), array(map(1, 2)));

