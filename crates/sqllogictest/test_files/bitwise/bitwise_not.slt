## Original Query: SELECT bitwise_not(0);
## PySpark 3.5.5 Result: {'bitwise_not(0)': -1, 'typeof(bitwise_not(0))': 'int', 'typeof(0)': 'int'}

# Basic tests with different integer types
query I
SELECT bitwise_not(0::int);
----
-1

query I
SELECT bitwise_not(1::int);
----
-2

query I
SELECT bitwise_not(7::int);
----
-8

query I
SELECT bitwise_not(15::int);
----
-16

query I
SELECT bitwise_not(255::int);
----
-256

query I
SELECT bitwise_not(1023::int);
----
-1024

# Tests with negative numbers (two's complement)
query I
SELECT bitwise_not(-1::int);
----
0

query I
SELECT bitwise_not(-2::int);
----
1

query I
SELECT bitwise_not(-3::int);
----
2

# Tests with different integer types
query I
SELECT bitwise_not(0::TINYINT);
----
-1

query I
SELECT bitwise_not(15::TINYINT);
----
-16

query I
SELECT bitwise_not((-1)::TINYINT);
----
0

query I
SELECT bitwise_not(0::SMALLINT);
----
-1

query I
SELECT bitwise_not(255::SMALLINT);
----
-256

query I
SELECT bitwise_not((-1)::SMALLINT);
----
0

query I
SELECT bitwise_not(0::INT);
----
-1

query I
SELECT bitwise_not(255::INT);
----
-256

query I
SELECT bitwise_not((-1)::INT);
----
0

query I
SELECT bitwise_not(0::BIGINT);
----
-1

query I
SELECT bitwise_not(255::BIGINT);
----
-256

query I
SELECT bitwise_not((-1)::BIGINT);
----
0

# Tests with NULL values
query I
SELECT bitwise_not(NULL::INT);
----
NULL

query I
SELECT bitwise_not(NULL::TINYINT);
----
NULL

query I
SELECT bitwise_not(NULL::BIGINT);
----
NULL

# Tests with edge cases
query I
SELECT bitwise_not(0::INT) as zero_not;
----
-1

query I
SELECT bitwise_not(1::INT) as one_not;
----
-2

query I
SELECT bitwise_not(2::INT) as two_not;
----
-3

query I
SELECT bitwise_not(3::INT) as three_not;
----
-4

query I
SELECT bitwise_not(4::INT) as four_not;
----
-5

query I
SELECT bitwise_not(5::INT) as five_not;
----
-6

# Tests with large numbers
query I
SELECT bitwise_not(2147483647::INT);
----
-2147483648

query I
SELECT bitwise_not((-2147483648)::INT);
----
2147483647

query I
SELECT bitwise_not(9223372036854775807::BIGINT);
----
-9223372036854775808

query I
SELECT bitwise_not((-9223372036854775808)::BIGINT);
----
9223372036854775807
