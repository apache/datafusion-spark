## Spark divides a non-DECIMAL pair as DOUBLE.

query R
SELECT 1 / 2;
----
0.5

query RR
SELECT 10 / 4, 3 / 2;
----
2.5 1.5

query R
SELECT 5 / CAST(2 AS DOUBLE);
----
2.5

## Integer, floating point and mixed columns are cast to DOUBLE

query R
SELECT a / b FROM (VALUES (1, 2), (3, 4)) t(a, b);
----
0.5
0.75

query RT
SELECT arrow_cast(1, 'Float32') / arrow_cast(2, 'Float32') AS r, arrow_typeof(arrow_cast(1, 'Float32') / arrow_cast(2, 'Float32')) AS t;
----
0.5 Float64

query RT
SELECT a / b, arrow_typeof(a / b) FROM (VALUES (CAST(1 AS INT), CAST(2 AS BIGINT))) t(a, b);
----
0.5 Float64

## A zero divisor returns NULL, with -0.0 counting as zero

query RR
SELECT 1 / 0, 1 / 0.0;
----
NULL NULL

query R
SELECT 1 / CAST(-0.0 AS DOUBLE);
----
NULL

## A NULL dividend stays NULL, even with a zero divisor

query TR
SELECT arrow_typeof(CAST(NULL AS DOUBLE) / 0), CAST(NULL AS DOUBLE) / 0;
----
Float64 NULL

## In ANSI mode a zero divisor raises instead

statement ok
set datafusion.execution.enable_ansi_mode = true;

query error Divide by zero
SELECT 1 / 0;

## ...but a row with a NULL dividend still returns NULL rather than raising

query TR
SELECT arrow_typeof(CAST(NULL AS DOUBLE) / 0), CAST(NULL AS DOUBLE) / 0;
----
Float64 NULL

statement ok
set datafusion.execution.enable_ansi_mode = false;

## DECIMAL operands keep the `/` operator's precision and scale

query T
SELECT arrow_typeof(CAST(1 AS DECIMAL(10,2)) / 2) AS t;
----
Decimal128(14, 6)

query R
SELECT CAST(1 AS DECIMAL(10,2)) / 2;
----
0.500000

## A DECIMAL divided by a floating point operand is coerced to DOUBLE

query TR
SELECT arrow_typeof(CAST(1 AS DECIMAL(10,2)) / CAST(2 AS DOUBLE)) AS t,
       CAST(1 AS DECIMAL(10,2)) / CAST(2 AS DOUBLE) AS r;
----
Float64 0.5

## ...so a zero divisor returns NULL, not an infinity

query TR
SELECT arrow_typeof(CAST(1 AS DECIMAL(10,2)) / CAST(0 AS DOUBLE)) AS t,
       CAST(1 AS DECIMAL(10,2)) / CAST(0 AS DOUBLE) AS r;
----
Float64 NULL

## Intervals are not numeric, so they keep DataFusion's `/` operator

query error Cannot get result type for temporal operation
SELECT INTERVAL '2' DAY / 2;
