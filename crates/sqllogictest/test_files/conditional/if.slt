# `if` has no `invoke_with_args` yet, so the records that call it are marked
# `skipif evaluate` until https://github.com/apache/datafusion-spark/issues/305 is fixed.

# This file was originally created by a porting script from:
#   https://github.com/lakehq/sail/tree/43b6ed8221de5c4c4adbedbb267ae1351158b43c/crates/sail-spark-connect/tests/gold_data/function
# This file is part of the implementation of the datafusion-spark function library.
# For more information, please see:
#   https://github.com/apache/datafusion/issues/15914

## Basic IF function tests

# Test basic true condition
skipif evaluate
query T
SELECT if(true, 'yes', 'no');
----
yes

# Test basic false condition
skipif evaluate
query T
SELECT if(false, 'yes', 'no');
----
no

# Test with comparison operators
skipif evaluate
query T
SELECT if(1 < 2, 'a', 'b');
----
a

skipif evaluate
query T
SELECT if(1 > 2, 'a', 'b');
----
b


## Numeric type tests

# Test with integers
skipif evaluate
query I
SELECT if(true, 10, 20);
----
10

skipif evaluate
query I
SELECT if(false, 10, 20);
----
20

# Test with different integer types
skipif evaluate
query I
SELECT if(true, 100, 200);
----
100

## Float type tests

# Test with floating point numbers
skipif evaluate
query R
SELECT if(true, 1.5, 2.5);
----
1.5

skipif evaluate
query R
SELECT if(false, 1.5, 2.5);
----
2.5

## String type tests

# Test with different string values
skipif evaluate
query T
SELECT if(true, 'hello', 'world');
----
hello

skipif evaluate
query T
SELECT if(false, 'hello', 'world');
----
world

## NULL handling tests

# Test with NULL condition
skipif evaluate
query T
SELECT if(NULL, 'yes', 'no');
----
no

skipif evaluate
query T
SELECT if(NOT NULL, 'yes', 'no');
----
no

# Test with NULL true value
skipif evaluate
query T
SELECT if(true, NULL, 'no');
----
NULL

# Test with NULL false value
skipif evaluate
query T
SELECT if(false, 'yes', NULL);
----
NULL

# Test with all NULL
skipif evaluate
query ?
SELECT if(true, NULL, NULL);
----
NULL

## Type coercion tests

# Test integer to float coercion
# xfail spark: Spark types the unsuffixed literals as INT/DECIMAL, DataFusion as BIGINT/DOUBLE (https://github.com/apache/datafusion-spark/issues/97)
skipif evaluate
query R
SELECT if(true, 10, 20.5);
----
10

skipif evaluate
query R
SELECT if(false, 10, 20.5);
----
20.5

# Test float to integer coercion
skipif evaluate
query R
SELECT if(true, 10.5, 20);
----
10.5

# xfail spark: Spark types the unsuffixed literals as INT/DECIMAL, DataFusion as BIGINT/DOUBLE (https://github.com/apache/datafusion-spark/issues/97)
skipif evaluate
query R
SELECT if(false, 10.5, 20);
----
20

statement error Int64 is not a boolean or null
SELECT if(1, 10.5, 20);


statement error Utf8 is not a boolean or null
SELECT if('x', 10.5, 20);

skipif evaluate
query IR
SELECT v, IF(v < 0, 10/0, 1) FROM (VALUES (1), (2)) t(v)
----
1 1
2 1

skipif evaluate
query R
SELECT IF(true, 1 / 1, 1 / 0);
----
1

## The branches are coerced to Spark's `findWiderTypeForTwo`

# A string promotes the other branch to a string
skipif evaluate
query TT
SELECT if(true, 1::INT, 'a'), arrow_typeof(if(true, 1::INT, 'a'));
----
1 Utf8

# An integer and a decimal widen to a decimal that holds both
skipif evaluate
query RT
SELECT if(true, 1::INT, 2.5::DECIMAL(2, 1)), arrow_typeof(if(true, 1::INT, 2.5::DECIMAL(2, 1)));
----
1.0 Decimal128(11, 1)

# A string in an array promotes the other array's elements
skipif evaluate
query ?
SELECT if(true, array(1::INT), array('a'));
----
[1]

# BOOLEAN and BINARY do not promote to a string
skipif evaluate
query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\] Input to `if` should all be the same type, but it's \["BOOLEAN", "STRING"\]\. SQLSTATE: 42K09
SELECT if(true, true, 'a');

skipif evaluate
query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\] Input to `if` should all be the same type, but it's \["INT", "ARRAY<INT>"\]\. SQLSTATE: 42K09
SELECT if(true, 1::INT, array(1::INT));

# With ANSI mode on, a string is cast to the other branch's type

statement ok
set datafusion.execution.enable_ansi_mode = true;

skipif evaluate
query IT
SELECT if(false, 1::INT, '2'), arrow_typeof(if(false, 1::INT, '2'));
----
2 Int64

skipif evaluate
query BT
SELECT if(false, true, 'true'), arrow_typeof(if(false, true, 'true'));
----
true Boolean

skipif evaluate
query error \[DATATYPE_MISMATCH\.DATA_DIFF_TYPES\] Input to `if` should all be the same type, but it's \["INT", "DATE"\]\. SQLSTATE: 42K09
SELECT if(true, 1::INT, DATE '2020-01-01');

statement ok
set datafusion.execution.enable_ansi_mode = false;
