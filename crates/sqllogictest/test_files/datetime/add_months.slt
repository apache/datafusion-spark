query D
SELECT add_months('2016-07-30'::date, 1::int);
----
2016-08-30

query D
SELECT add_months('2016-07-30'::date, 0::int);
----
2016-07-30

query D
SELECT add_months('2016-07-30'::date, 10000::int);
----
2849-11-30

# Test integer overflow
query error
SELECT add_months('2016-07-30'::date, 2147483647::int);
----
DataFusion error: Arrow error: Compute error: Date arithmetic overflow: 17012 + 2147483647 months


query D
SELECT add_months('2016-07-30'::date, -5::int);
----
2016-02-29

# Test with NULL values
query D
SELECT add_months(NULL::date, 1::int);
----
NULL

query D
SELECT add_months('2016-07-30'::date, NULL::int);
----
NULL

query D
SELECT add_months(NULL::date, NULL::int);
----
NULL

# Column arguments, with the day clamped to the end of a shorter month
query D
SELECT add_months(d, m) FROM VALUES
  ('2016-07-30'::date, 1::int),
  ('2016-08-31'::date, 1::int),
  ('2024-01-31'::date, 1::int),
  (NULL::date, 1::int),
  ('2016-07-30'::date, NULL::int)
  AS t(d, m);
----
2016-08-30
2016-09-30
2024-02-29
NULL
NULL

# Scalar date with a column of months
query D
SELECT add_months('2024-01-31'::date, m) FROM VALUES (1::int), (-1::int), (13::int) AS t(m);
----
2024-02-29
2023-12-31
2025-02-28

# Column of dates with a scalar month count
query D
SELECT add_months(d, 1::int) FROM VALUES ('2016-01-31'::date), ('2016-02-29'::date), (NULL::date) AS t(d);
----
2016-02-29
2016-03-29
NULL

# Spark implicitly casts a string to DATE and returns 2024-02-29 (https://github.com/apache/datafusion-spark/issues/41)
# xfail spark: Spark implicitly casts a string argument to DATE/TIMESTAMP, invalid strings give NULL (https://github.com/apache/datafusion-spark/issues/41)
statement error Failed to coerce arguments to satisfy a call to 'add_months' function
SELECT add_months('2024-01-31', 1::INT);

# An integer literal is BIGINT here and INT in Spark, where this returns 2024-02-29 (https://github.com/apache/datafusion-spark/issues/97)
# xfail spark: An integer literal is BIGINT here and INT in Spark (https://github.com/apache/datafusion-spark/issues/97)
statement error Failed to coerce arguments to satisfy a call to 'add_months' function
SELECT add_months(DATE '2024-01-31', 1);
