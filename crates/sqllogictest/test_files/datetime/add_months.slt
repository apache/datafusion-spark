query D
SELECT add_months('2016-07-30'::date, 1::int);
----
2016-08-30

query D
SELECT add_months('2016-07-30'::date, 0::int);
----
2016-07-30

query D
SELECT add_months('2016-07-30'::date, 10000::int);
----
2849-11-30

# Test integer overflow
query error
SELECT add_months('2016-07-30'::date, 2147483647::int);
----
DataFusion error: Arrow error: Compute error: Date arithmetic overflow: 17012 + 2147483647 months


query D
SELECT add_months('2016-07-30'::date, -5::int);
----
2016-02-29

# Test with NULL values
query D
SELECT add_months(NULL::date, 1::int);
----
NULL

query D
SELECT add_months('2016-07-30'::date, NULL::int);
----
NULL

query D
SELECT add_months(NULL::date, NULL::int);
----
NULL

# Spark implicitly casts a string to DATE and returns 2024-02-29 (https://github.com/apache/datafusion-spark/issues/41)
statement error Failed to coerce arguments to satisfy a call to 'add_months' function
SELECT add_months('2024-01-31', 1::INT);

# An integer literal is BIGINT here and INT in Spark, where this returns 2024-02-29 (https://github.com/apache/datafusion-spark/issues/97)
statement error Failed to coerce arguments to satisfy a call to 'add_months' function
SELECT add_months(DATE '2024-01-31', 1);
