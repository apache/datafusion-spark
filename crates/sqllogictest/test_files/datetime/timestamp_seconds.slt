# Original placeholder queries were ported from:
# https://github.com/lakehq/sail/tree/43b6ed8221de5c4c4adbedbb267ae1351158b43c/crates/sail-spark-connect/tests/gold_data/function

# Expected results verified against Apache Spark 4.2.0.

query PPP
SELECT timestamp_seconds(1230219000::INT), timestamp_seconds('1230219000.123'::DECIMAL(13,3)), timestamp_seconds(-1230219000::BIGINT);
----
2008-12-25T15:30:00Z 2008-12-25T15:30:00.123Z 1931-01-07T08:30:00Z

query PPPP
SELECT timestamp_seconds(NULL) AS untyped_null, timestamp_seconds(NULL::BIGINT) AS integer_null,
  timestamp_seconds(NULL::DOUBLE) AS double_null, timestamp_seconds(NULL::DECIMAL(38,7)) AS decimal_null;
----
NULL NULL NULL NULL

# Use string-to-DECIMAL casts to avoid DataFusion parsing fractional literals as DOUBLE.
# Arithmetic semantics are independent of ANSI mode.
statement ok
SET datafusion.execution.enable_ansi_mode = false;

query I
SELECT unix_micros(timestamp_seconds(x)) FROM (VALUES ((-1)::TINYINT), (0::TINYINT), (1::TINYINT), (NULL::TINYINT)) AS t(x);
----
-1000000
0
1000000
NULL

query I
SELECT unix_micros(timestamp_seconds(x)) FROM (VALUES ((-1)::SMALLINT), (0::SMALLINT), (1::SMALLINT), (NULL::SMALLINT)) AS t(x);
----
-1000000
0
1000000
NULL

query I
SELECT unix_micros(timestamp_seconds(x)) FROM (VALUES ((-1)::INT), (0::INT), (1::INT), (NULL::INT)) AS t(x);
----
-1000000
0
1000000
NULL

query I
SELECT unix_micros(timestamp_seconds(x)) FROM (VALUES ((-1)::BIGINT), (0::BIGINT), (1::BIGINT), (NULL::BIGINT)) AS t(x);
----
-1000000
0
1000000
NULL

query II
SELECT unix_micros(timestamp_seconds((-9223372036854)::BIGINT)), unix_micros(timestamp_seconds(9223372036854::BIGINT));
----
-9223372036854000000 9223372036854000000

query error long overflow
SELECT timestamp_seconds((9223372036855)::BIGINT);

query error long overflow
SELECT timestamp_seconds((-9223372036855)::BIGINT);

query error long overflow
SELECT timestamp_seconds((9223372036854775807)::BIGINT);

query error long overflow
SELECT timestamp_seconds((-9223372036854775808)::BIGINT);

query error long overflow
SELECT timestamp_seconds(x) FROM (VALUES (1::BIGINT), (9223372036855::BIGINT)) AS t(x);

query I
SELECT unix_micros(timestamp_seconds(x)) FROM (VALUES ('-1.5'::DECIMAL(38,7)), ('0.1234560'::DECIMAL(38,7)), (NULL::DECIMAL(38,7))) AS t(x);
----
-1500000
123456
NULL

query II
SELECT unix_micros(timestamp_seconds('9223372036854.775807'::DECIMAL(38,6))), unix_micros(timestamp_seconds('-9223372036854.775808'::DECIMAL(38,6)));
----
9223372036854775807 -9223372036854775808

query I
SELECT unix_micros(timestamp_seconds('1'::DECIMAL(38,0)));
----
1000000

query error Rounding necessary
SELECT timestamp_seconds('0.1234567'::DECIMAL(38,7));

query error Rounding necessary
SELECT timestamp_seconds('-0.0000001'::DECIMAL(38,7));

query error Rounding necessary
SELECT timestamp_seconds(x) FROM (VALUES ('1.0'::DECIMAL(38,7)), ('0.1234567'::DECIMAL(38,7))) AS t(x);

query error Overflow
SELECT timestamp_seconds('99999999999999999999999999999999999999'::DECIMAL(38,0));

query error Overflow
SELECT timestamp_seconds('9223372036854.775808'::DECIMAL(38,6));

query error Overflow
SELECT timestamp_seconds('-9223372036854.775809'::DECIMAL(38,6));

query error Overflow
SELECT timestamp_seconds('10000000000000.0000001'::DECIMAL(38,7));

query I
SELECT unix_micros(timestamp_seconds(x)) FROM (VALUES ('1.23'::FLOAT), ('-1.23'::FLOAT), ('0.1234567'::FLOAT), ('-0.0000015'::FLOAT), ('-0.0'::FLOAT), ('NaN'::FLOAT), ('Infinity'::FLOAT), ('-Infinity'::FLOAT), (NULL::FLOAT)) AS t(x);
