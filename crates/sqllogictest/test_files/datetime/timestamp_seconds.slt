query error WRONG_NUM_ARGS
SELECT timestamp_seconds();

query error WRONG_NUM_ARGS
SELECT timestamp_seconds(1, 2);

statement ok
SET datafusion.execution.time_zone = 'America/Los_Angeles';

query PP
SELECT timestamp_seconds(1230219000::BIGINT), timestamp_seconds('1230219000.123'::DECIMAL(13,3));
----
2008-12-25T07:30:00-08:00 2008-12-25T07:30:00.123-08:00

query PI
SELECT timestamp_seconds(x), unix_micros(timestamp_seconds(x)) FROM (VALUES (1552211999::BIGINT), (1552212000::BIGINT)) AS t(x);
----
2019-03-10T01:59:59-08:00 1552211999000000
2019-03-10T03:00:00-07:00 1552212000000000

statement ok
SET datafusion.execution.time_zone = 'UTC';

query T
SELECT arrow_typeof(timestamp_seconds(0::BIGINT));
----
Timestamp(µs, "UTC")


# Scalar floating-point execution follows the same truncation and NULL rules.
query IIIIP
SELECT unix_micros(timestamp_seconds('1.23'::FLOAT)),
  unix_micros(timestamp_seconds('-0.0000015'::DOUBLE)),
  unix_micros(timestamp_seconds('-0.0'::DOUBLE)),
  unix_micros(timestamp_seconds('0.1234567'::DOUBLE)),
  timestamp_seconds('NaN'::DOUBLE);
----
1230000 -1 0 123456 NULL

query error The first parameter of `timestamp_seconds` requires the "NUMERIC" type, however it has the type "STRING".
SELECT timestamp_seconds('1');

# Spark DateExpressionsSuite cases: widening FLOAT before multiplication is essential.
query II
SELECT unix_micros(timestamp_seconds(16777215::FLOAT)),
  unix_micros(timestamp_seconds(123.456789123::DOUBLE));
----
16777215000000 123456789

query I
SELECT unix_micros(timestamp_seconds(x))
FROM (VALUES (16777215::FLOAT), (-16777215::FLOAT), (NULL::FLOAT)) AS t(x);
----
16777215000000
-16777215000000
NULL

# Spark's BigDecimal checks large integer digits before rounding, but otherwise
# fractional microseconds take precedence over the signed BIGINT range check.
query error Rounding necessary
SELECT timestamp_seconds('9223372036854.7758081'::DECIMAL(38,7));

query error DATATYPE_MISMATCH.UNEXPECTED_INPUT_TYPE
SELECT timestamp_seconds(NULL::STRING);
