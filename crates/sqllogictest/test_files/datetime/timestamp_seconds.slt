statement ok
SET datafusion.execution.enable_ansi_mode = false;

query I
SELECT unix_micros(timestamp_seconds(arrow_cast(x, 'Dictionary(Int32, Int64)'))) FROM (VALUES (1::BIGINT), (-1::BIGINT), (NULL::BIGINT)) AS t(x);
----
1000000
-1000000
NULL

query I
SELECT unix_micros(timestamp_seconds(arrow_cast(x, 'Dictionary(Int32, Float32)'))) FROM (VALUES ('1.23'::FLOAT), ('NaN'::FLOAT), (NULL::FLOAT)) AS t(x);
----
1230000
NULL
NULL

query I
SELECT unix_micros(timestamp_seconds(arrow_cast(x, 'Dictionary(Int32, Float64)'))) FROM (VALUES ('0.1234567'::DOUBLE), ('Infinity'::DOUBLE), (NULL::DOUBLE)) AS t(x);
----
123456
NULL
NULL

query I
SELECT unix_micros(timestamp_seconds(arrow_cast(x, 'Dictionary(Int32, Decimal128(38, 7))'))) FROM (VALUES ('1.2300000'::DECIMAL(38,7)), ('-1.5000000'::DECIMAL(38,7)), (NULL::DECIMAL(38,7))) AS t(x);
----
1230000
-1500000
NULL

query III
SELECT unix_micros(timestamp_seconds(arrow_cast(255, 'UInt8'))), unix_micros(timestamp_seconds(arrow_cast(65535, 'UInt16'))), unix_micros(timestamp_seconds(arrow_cast(4294967295, 'UInt32')));
----
255000000 65535000000 4294967295000000

query I
SELECT unix_micros(timestamp_seconds(arrow_cast(1, 'UInt64')));
----
1000000

query error Overflow
SELECT timestamp_seconds(arrow_cast('18446744073709551615', 'UInt64'));

